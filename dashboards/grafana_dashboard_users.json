        {
          "id": "organize",
          "options": {
            "excludeByName": {"Time": true},
            "indexByName": {"user": 0, "Value #A": 1, "Value #B": 2},
            "renameByName": {
              "user": "User",
              "Value #A": "Requests",
              "Value #B": "Cost (USD)"
            }
          }
        },
        {
          "id": "renameByRegex",
          "options": {"regex": "_at_", "renamePattern": "@"}
