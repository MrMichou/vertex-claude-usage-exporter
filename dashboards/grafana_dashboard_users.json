          "countRows": false,
          "fields": ["Requests", "Cost (USD)"],
          "reducer": ["sum"],
          "show": true
        },
        "showHeader": true,
        "sortBy": [{"desc": true, "displayName": "Cost (USD)"}]
      },
      "pluginVersion": "10.0.0",
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "${datasource}"},
          "expr": "sum by (user) (claude_vertex_requests_total{project=~\"$project\", date=~\"$date\"})",
          "format": "table",
          "instant": true,
          "refId": "A"
        },
        {
          "datasource": {"type": "prometheus", "uid": "${datasource}"},
          "expr": "sum by (user) (claude_vertex_estimated_cost_usd{project=~\"$project\", date=~\"$date\"})",
